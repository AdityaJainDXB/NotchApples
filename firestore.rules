rules_version = '2';
// Notch apple. Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed-in users: their own settings and licence only.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Product keys from the website, stored by SHA-256 only. Fetch by exact hash, never list.
    match /keys/{hash} {
      allow get: if true;
      allow list, delete: if false;
      // New keys come from the license server (signed keys) since 4 October 2026; nothing new is created here.
      allow create: if false;
      // Redeem once: only unused -> used, only these fields.
      allow update: if resource.data.redeemed == false && request.resource.data.redeemed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemed', 'redeemedAt', 'mac']);
    }

    // One key per payment (transaction id) or promo code. Created once, never changed.
    match /claims/{ref} {
      allow get: if true;
      allow list, update, delete: if false;
      allow create: if false;
    }
  }
}
